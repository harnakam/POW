diff --git a/codex-rs/core/src/tools/native_scheduler.rs b/codex-rs/core/src/tools/native_scheduler.rs
new file mode 100644
index 0000000..dcb2fe0
--- /dev/null
+++ b/codex-rs/core/src/tools/native_scheduler.rs
@@ -0,0 +1,302 @@
+//! Process-wide, opt-in admission for native tool dispatch.
+//!
+//! Existing runtime permissions and parallel-safety gates remain authoritative.
+//! This gate bounds work already submitted; it never rewrites JavaScript awaits.
+
+use std::sync::OnceLock;
+use tokio::sync::Semaphore;
+use tokio::sync::SemaphorePermit;
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum Admission {
+    Control,
+    Leaf,
+    Review,
+}
+
+struct Scheduler {
+    primary: Semaphore,
+    review: Semaphore,
+}
+
+impl Scheduler {
+    fn new(limit: usize) -> Self {
+        Self {
+            primary: Semaphore::new(limit),
+            review: Semaphore::new(1),
+        }
+    }
+}
+
+pub(super) fn for_session(
+    admission: Admission,
+    source: &codex_protocol::protocol::SessionSource,
+) -> Admission {
+    if matches!(admission, Admission::Leaf) && crate::guardian::is_basic_session_source(source) {
+        Admission::Review
+    } else {
+        admission
+    }
+}
+
+static GATE: OnceLock<Result<Option<Scheduler>, String>> = OnceLock::new();
+
+fn parse_limit(value: Option<&str>) -> Result<Option<usize>, String> {
+    match value {
+        None => Ok(None),
+        Some(value) => match value.parse::<usize>() {
+            Ok(limit @ 1..=1024) => Ok(Some(limit)),
+            _ => Err("CODEX_NATIVE_TOOL_CONCURRENCY must be an integer from 1 to 1024".to_string()),
+        },
+    }
+}
+
+pub(super) async fn acquire(
+    admission: Admission,
+) -> Result<Option<SemaphorePermit<'static>>, String> {
+    let gate = GATE.get_or_init(|| {
+        let value = match std::env::var("CODEX_NATIVE_TOOL_CONCURRENCY") {
+            Ok(value) => Some(value),
+            Err(std::env::VarError::NotPresent) => None,
+            Err(std::env::VarError::NotUnicode(_)) => {
+                return Err("CODEX_NATIVE_TOOL_CONCURRENCY must contain valid Unicode".to_string());
+            }
+        };
+        let limit = parse_limit(value.as_deref())?;
+        if let Some(limit) = limit {
+            tracing::info!(limit, review_limit = 1, "native tool scheduler enabled");
+        }
+        Ok(limit.map(Scheduler::new))
+    });
+    if matches!(admission, Admission::Control) {
+        return Ok(None);
+    }
+    let gate = gate.as_ref().map_err(Clone::clone)?;
+    Ok(acquire_from(gate.as_ref(), admission).await)
+}
+
+async fn acquire_from(
+    gate: Option<&Scheduler>,
+    admission: Admission,
+) -> Option<SemaphorePermit<'_>> {
+    if matches!(admission, Admission::Control) {
+        return None;
+    }
+    match gate {
+        Some(gate) => {
+            let permits = match admission {
+                Admission::Control => return None,
+                Admission::Leaf => &gate.primary,
+                Admission::Review => &gate.review,
+            };
+            Some(
+                permits
+                    .acquire()
+                    .await
+                    .expect("native scheduler gate never closes"),
+            )
+        }
+        None => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::Admission;
+    use super::Scheduler;
+    use super::acquire_from;
+    use super::parse_limit;
+    use std::time::Duration;
+    use tokio::time::timeout;
+
+    #[test]
+    fn configuration_is_optional_but_invalid_configuration_fails_closed() {
+        assert_eq!(parse_limit(None), Ok(None));
+        assert_eq!(parse_limit(Some("4")), Ok(Some(4)));
+        assert_eq!(parse_limit(Some("1")), Ok(Some(1)));
+        assert_eq!(parse_limit(Some("1024")), Ok(Some(1024)));
+        for value in ["", "0", "1025", "four", "-1"] {
+            assert!(parse_limit(Some(value)).is_err(), "{value}");
+        }
+    }
+
+    #[tokio::test]
+    async fn control_can_dispatch_and_wait_for_child_at_limit_one() {
+        let gate = Scheduler::new(1);
+        let control = acquire_from(Some(&gate), Admission::Control).await;
+        let child = timeout(
+            Duration::from_secs(1),
+            acquire_from(Some(&gate), Admission::Leaf),
+        )
+        .await
+        .expect("control must not consume child capacity");
+        assert!(control.is_none());
+        assert_eq!(gate.primary.available_permits(), 0);
+        drop(child);
+        assert_eq!(gate.primary.available_permits(), 1);
+    }
+
+    #[tokio::test]
+    async fn concurrent_calls_queue_and_cancelled_waiter_does_not_leak() {
+        let gate = Scheduler::new(1);
+        let active = acquire_from(Some(&gate), Admission::Leaf).await;
+        assert!(
+            timeout(
+                Duration::from_millis(10),
+                acquire_from(Some(&gate), Admission::Leaf)
+            )
+            .await
+            .is_err()
+        );
+        drop(active);
+        let next = timeout(
+            Duration::from_secs(1),
+            acquire_from(Some(&gate), Admission::Leaf),
+        )
+        .await
+        .expect("released capacity must be reusable");
+        assert_eq!(gate.primary.available_permits(), 0);
+        drop(next);
+        assert_eq!(gate.primary.available_permits(), 1);
+    }
+
+    #[tokio::test]
+    async fn failed_execution_releases_capacity() {
+        let gate = Scheduler::new(1);
+        let result: Result<(), &str> = async {
+            let _permit = acquire_from(Some(&gate), Admission::Leaf).await;
+            Err("tool failure")
+        }
+        .await;
+        assert_eq!(result, Err("tool failure"));
+        assert_eq!(gate.primary.available_permits(), 1);
+        assert!(acquire_from(None, Admission::Leaf).await.is_none());
+    }
+
+    #[tokio::test]
+    async fn aborting_active_execution_releases_capacity() {
+        let gate = std::sync::Arc::new(Scheduler::new(1));
+        let worker_gate = std::sync::Arc::clone(&gate);
+        let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+        let worker = tokio::spawn(async move {
+            let _permit = acquire_from(Some(&worker_gate), Admission::Leaf).await;
+            let _ = started_tx.send(());
+            std::future::pending::<()>().await;
+        });
+        started_rx.await.expect("worker must acquire capacity");
+        assert_eq!(gate.primary.available_permits(), 0);
+        worker.abort();
+        assert!(worker.await.expect_err("worker must abort").is_cancelled());
+        assert_eq!(gate.primary.available_permits(), 1);
+    }
+
+    #[tokio::test]
+    async fn image_reads_queue_while_agent_coordination_remains_available() {
+        use crate::tools::handlers::ViewImageHandler;
+        use crate::tools::handlers::multi_agents::WaitAgentHandler;
+        use crate::tools::multi_agent_tool::multi_agent_v2_handler;
+        use crate::tools::registry::CoreToolRuntime;
+
+        let gate = Scheduler::new(1);
+        let image_reader = ViewImageHandler::default();
+        // Analytics labels this a control tool; admission must still bound I/O.
+        assert!(image_reader.is_builtin_control_tool());
+        let active_read = acquire_from(Some(&gate), image_reader.scheduler_admission()).await;
+        assert!(
+            timeout(
+                Duration::from_millis(10),
+                acquire_from(Some(&gate), image_reader.scheduler_admission())
+            )
+            .await
+            .is_err()
+        );
+        let waiter = multi_agent_v2_handler(
+            WaitAgentHandler::default(),
+            Some("custom_collaboration"),
+            None,
+            None,
+        );
+        let coordination = timeout(
+            Duration::from_secs(1),
+            acquire_from(Some(&gate), waiter.scheduler_admission()),
+        )
+        .await
+        .expect("namespaced coordination must bypass exhausted leaf capacity");
+        assert!(coordination.is_none());
+        drop(active_read);
+        assert_eq!(gate.primary.available_permits(), 1);
+    }
+
+    #[tokio::test]
+    async fn guardian_review_has_bounded_capacity_independent_of_approval_parents() {
+        use super::for_session;
+        use codex_protocol::protocol::InternalSessionSource;
+        use codex_protocol::protocol::SessionSource;
+        use codex_protocol::protocol::SubAgentSource;
+
+        let gate = Scheduler::new(1);
+        let parent = acquire_from(Some(&gate), Admission::Leaf).await;
+        let guardian = SessionSource::Internal(InternalSessionSource::Guardian);
+        let review = timeout(
+            Duration::from_secs(1),
+            acquire_from(Some(&gate), for_session(Admission::Leaf, &guardian)),
+        )
+        .await
+        .expect("Guardian must progress while approval parents occupy primary capacity");
+        assert_eq!(gate.review.available_permits(), 0);
+        assert!(
+            timeout(
+                Duration::from_millis(10),
+                acquire_from(Some(&gate), for_session(Admission::Leaf, &guardian))
+            )
+            .await
+            .is_err()
+        );
+        for ordinary in [
+            SessionSource::SubAgent(SubAgentSource::Review),
+            SessionSource::SubAgent(SubAgentSource::Other("ordinary".to_string())),
+        ] {
+            assert!(
+                timeout(
+                    Duration::from_millis(10),
+                    acquire_from(Some(&gate), for_session(Admission::Leaf, &ordinary))
+                )
+                .await
+                .is_err()
+            );
+        }
+        drop(review);
+        assert_eq!(gate.review.available_permits(), 1);
+        let basic = SessionSource::SubAgent(SubAgentSource::Other(
+            crate::guardian::GUARDIAN_REVIEWER_NAME.to_string(),
+        ));
+        let another = timeout(
+            Duration::from_secs(1),
+            acquire_from(Some(&gate), for_session(Admission::Leaf, &basic)),
+        )
+        .await
+        .expect("canonical basic Guardian source must share the review reserve");
+        drop(another);
+        drop(parent);
+        assert_eq!(gate.primary.available_permits(), 1);
+        assert_eq!(gate.review.available_permits(), 1);
+    }
+
+    #[tokio::test]
+    async fn cancelling_guardian_execution_releases_review_reserve() {
+        let gate = std::sync::Arc::new(Scheduler::new(1));
+        let worker_gate = std::sync::Arc::clone(&gate);
+        let (started_tx, started_rx) = tokio::sync::oneshot::channel();
+        let worker = tokio::spawn(async move {
+            let _permit = acquire_from(Some(&worker_gate), Admission::Review).await;
+            let _ = started_tx.send(());
+            std::future::pending::<()>().await;
+        });
+        started_rx.await.expect("review must acquire reserve");
+        assert_eq!(gate.review.available_permits(), 0);
+        worker.abort();
+        assert!(worker.await.expect_err("review must abort").is_cancelled());
+        assert_eq!(gate.primary.available_permits(), 1);
+        assert_eq!(gate.review.available_permits(), 1);
+    }
+}
