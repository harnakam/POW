{
  "version": 1,
  "source_roots": ["."],
  "presets": {
    "check": {
      "jobs": [
        {"id": "tests", "argv": ["{python}", "-B", "-m", "unittest", "-v", "test_example"], "timeout_s": 30},
        {"id": "syntax", "operation": "syntax", "parameters": {"paths": ["example.py", "test_example.py"]}}
      ]
    },
    "inspect": {
      "jobs": [
        {"id": "index", "operation": "index"},
        {"id": "greeting", "operation": "symbols", "parameters": {"query": "greet"}, "depends_on": ["index"]}
      ]
    }
  }
}
